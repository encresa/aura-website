---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import SpeedComparison from '../components/SpeedComparison.astro';
import AuraRouter from '../components/AuraRouter.astro';
import AuraStory from '../components/AuraStory.astro';
import MemoryTiers from '../components/MemoryTiers.astro';
import SkillStore from '../components/SkillStore.astro';
import VoiceInterface from '../components/VoiceInterface.astro';
import Architecture from '../components/Architecture.astro';
import CallToAction from '../components/CallToAction.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="AURA | The World's Fastest AI Secretary">
  <Navigation />
  <main>
    <Hero />
    <SpeedComparison />
    <AuraStory />
    <AuraRouter />
    <MemoryTiers />
    <SkillStore />
    <VoiceInterface />
    <Architecture />
    <CallToAction />
  </main>
  <Footer />
</Layout>
