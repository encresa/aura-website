---
// Super Memory 3.0 Section - Memory Tiers (with reveal animations)
---

<section id="memory" class="memory-section reveal-section">
  <div class="section-header">
    <span class="section-tag reveal-item" data-delay="0">
      <i data-lucide="layers" class="tag-icon"></i>
      Super Memory 3.0
    </span>
    <h2 class="section-title reveal-item" data-delay="100">3-Tier Memory Architecture</h2>
    <p class="section-subtitle reveal-item" data-delay="200">From lightning-fast context to infinite knowledge archives.</p>
  </div>
  
  <div class="memory-tiers">
    <!-- Tier 1: Hot Memory -->
    <div class="memory-orb hot reveal-item" data-delay="300">
      <div class="orb-visual">
        <div class="orb-core hot-core"></div>
        <div class="orb-particles"></div>
      </div>
      <div class="orb-content">
        <div class="orb-header">
          <i data-lucide="flame" class="orb-icon text-heartbeat"></i>
          <span class="orb-tier">Tier 1</span>
        </div>
        <h3 class="orb-title">The Spark</h3>
        <p class="orb-label">Injected Context (&lt;10ms)</p>
        <p class="orb-detail">The Cheat Sheet. What you are doing <em>right now</em>.</p>
      </div>
    </div>
    
    <!-- Connector -->
    <div class="memory-connector reveal-item" data-delay="400">
      <div class="connector-line"></div>
      <i data-lucide="chevrons-down" class="connector-icon"></i>
    </div>
    
    <!-- Tier 2: Warm Memory -->
    <div class="memory-orb warm reveal-item" data-delay="500">
      <div class="orb-visual">
        <div class="orb-core warm-core"></div>
        <div class="orb-crystal"></div>
      </div>
      <div class="orb-content">
        <div class="orb-header">
          <i data-lucide="user" class="orb-icon text-tether"></i>
          <span class="orb-tier">Tier 2</span>
        </div>
        <h3 class="orb-title">The Profile</h3>
        <p class="orb-label">Active Profile (~100ms)</p>
        <div class="profile-preview glass">
          <pre><code>{`{
  "identity": "Startup Founder",
  "diet": "Vegetarian",
  "timezone": "Asia/Kolkata"
}`}</code></pre>
        </div>
      </div>
    </div>
    
    <!-- Connector -->
    <div class="memory-connector reveal-item" data-delay="600">
      <div class="connector-line"></div>
      <i data-lucide="chevrons-down" class="connector-icon"></i>
    </div>
    
    <!-- Tier 3: Cold Memory -->
    <div class="memory-orb cold reveal-item" data-delay="700">
      <div class="orb-visual">
        <div class="orb-core cold-core"></div>
        <div class="orb-ocean">
          <div class="particle"></div>
          <div class="particle"></div>
          <div class="particle"></div>
          <div class="particle"></div>
          <div class="particle"></div>
        </div>
      </div>
      <div class="orb-content">
        <div class="orb-header">
          <i data-lucide="database" class="orb-icon text-cold"></i>
          <span class="orb-tier">Tier 3</span>
        </div>
        <h3 class="orb-title">The Archive</h3>
        <p class="orb-label">Infinite Archive (pgvector)</p>
        <p class="orb-detail">Every conversation, every preference, searchable forever.</p>
      </div>
    </div>
  </div>
</section>
