---
// Footer Component - Updated links with base URL
const base = import.meta.env.BASE_URL;
---

<footer class="footer">
  <div class="footer-content">
    <div class="footer-brand">
      <img src={`${base}assets/icon_512.png`} alt="AURA Logo" class="footer-logo">
      <span class="footer-title">AURA</span>
      <span class="footer-tagline">by Encresa</span>
    </div>
    <div class="footer-links">
      <a href={`${base}#features`} class="footer-link">Features</a>
      <a href={`${base}#router`} class="footer-link">Router</a>
      <a href={`${base}#memory`} class="footer-link">Memory</a>
      <a href={`${base}#tools`} class="footer-link">Tools</a>
      <a href={`${base}initialize`} class="footer-link">Waitlist</a>
    </div>
    <div class="footer-copy">
      <p>&copy; 2025 Encresa. All rights reserved.</p>
    </div>
  </div>
</footer>
