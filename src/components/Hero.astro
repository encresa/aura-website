---
// Hero Section - The Arrival (with enhanced AURA Core animation)
---

<section id="hero" class="hero-section">
  <div class="hero-content">
    <!-- The AURA Core Visualization - Living, Breathing Entity -->
    <div class="aura-core">
      <!-- Outer Energy Field -->
      <div class="energy-field">
        <div class="energy-ring ring-outer"></div>
        <div class="energy-ring ring-mid"></div>
        <div class="energy-ring ring-inner"></div>
      </div>
      
      <!-- Floating Particles -->
      <div class="particle-field">
        <div class="particle p1"></div>
        <div class="particle p2"></div>
        <div class="particle p3"></div>
        <div class="particle p4"></div>
        <div class="particle p5"></div>
        <div class="particle p6"></div>
        <div class="particle p7"></div>
        <div class="particle p8"></div>
      </div>
      
      <!-- Core Rings with Ice Physics -->
      <div class="core-inner">
        <div class="core-ring ring-1"></div>
        <div class="core-ring ring-2"></div>
        <div class="core-ring ring-3"></div>
        
        <!-- The Living Sphere -->
        <div class="core-sphere">
          <div class="sphere-surface"></div>
          <div class="sphere-glow"></div>
          <div class="sphere-shine"></div>
        </div>
        
        <!-- Breathing Pulse -->
        <div class="core-pulse"></div>
        <div class="core-pulse pulse-delayed"></div>
      </div>
      
      <!-- Ambient Glow -->
      <div class="core-glow"></div>
      <div class="core-aurora"></div>
    </div>
    
    <h1 class="hero-headline">
      <span class="headline-accent">The World's Fastest</span>
      <span class="headline-main">AI Secretary</span>
    </h1>
    
    <p class="hero-subtext">
      A digital body double. <span class="text-halo">Hybrid Brain.</span> <span class="text-tether">Infinite Context.</span>
    </p>
    
    <!-- The Tension Button -->
    <a href="/initialize" class="btn btn-primary btn-hero tension-button">
      <span>Initialize AURA</span>
      <i data-lucide="arrow-right" class="btn-icon"></i>
    </a>
    
    <div class="hero-stats">
      <div class="stat-item">
        <span class="stat-value">12ms</span>
        <span class="stat-label">Response Time</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="stat-value">∞</span>
        <span class="stat-label">Context Memory</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="stat-value">24/7</span>
        <span class="stat-label">Always On</span>
      </div>
    </div>
  </div>
  
  <div class="scroll-indicator">
    <i data-lucide="chevron-down" class="scroll-icon"></i>
  </div>
</section>

<style>
  /* ========== AURA Core - Living Entity ========== */
  .aura-core {
    position: relative;
    width: 320px;
    height: 320px;
    margin: 0 auto var(--space-3xl);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  /* Energy Field - Outer Aura */
  .energy-field {
    position: absolute;
    inset: -40px;
    pointer-events: none;
  }
  
  .energy-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid transparent;
  }
  
  .ring-outer {
    inset: -20px;
    border-color: rgba(0, 240, 255, 0.1);
    animation: energy-pulse 4s ease-in-out infinite;
  }
  
  .ring-mid {
    inset: 0;
    border-color: rgba(0, 240, 255, 0.15);
    animation: energy-pulse 4s ease-in-out infinite 0.5s;
  }
  
  .ring-inner {
    inset: 20px;
    border-color: rgba(0, 240, 255, 0.2);
    animation: energy-pulse 4s ease-in-out infinite 1s;
  }
  
  @keyframes energy-pulse {
    0%, 100% { transform: scale(1); opacity: 0.3; }
    50% { transform: scale(1.1); opacity: 0.6; }
  }
  
  /* Particle Field - Floating Dust */
  .particle-field {
    position: absolute;
    inset: -60px;
    pointer-events: none;
  }
  
  .particle {
    position: absolute;
    width: 4px;
    height: 4px;
    background: var(--halo);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--halo), 0 0 20px var(--halo-glow);
  }
  
  .p1 { top: 10%; left: 20%; animation: particle-float 8s ease-in-out infinite; }
  .p2 { top: 30%; left: 5%; animation: particle-float 10s ease-in-out infinite 1s; }
  .p3 { top: 70%; left: 15%; animation: particle-float 9s ease-in-out infinite 2s; }
  .p4 { top: 85%; left: 40%; animation: particle-float 11s ease-in-out infinite 0.5s; }
  .p5 { top: 80%; right: 20%; animation: particle-float 8s ease-in-out infinite 1.5s; }
  .p6 { top: 50%; right: 5%; animation: particle-float 10s ease-in-out infinite 2.5s; }
  .p7 { top: 20%; right: 15%; animation: particle-float 9s ease-in-out infinite 0.8s; }
  .p8 { top: 5%; left: 50%; animation: particle-float 7s ease-in-out infinite 1.2s; }
  
  @keyframes particle-float {
    0%, 100% { 
      transform: translate(0, 0) scale(1); 
      opacity: 0.4;
    }
    25% { 
      transform: translate(10px, -15px) scale(1.5); 
      opacity: 0.8;
    }
    50% { 
      transform: translate(-5px, -25px) scale(1); 
      opacity: 0.6;
    }
    75% { 
      transform: translate(-15px, -10px) scale(1.3); 
      opacity: 0.9;
    }
  }
  
  /* Core Inner Structure */
  .core-inner {
    position: relative;
    width: 200px;
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  /* Rotating Rings with Ice Physics (smooth deceleration) */
  .core-ring {
    position: absolute;
    border-radius: 50%;
    border: 2px solid transparent;
    animation-timing-function: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  
  .ring-1 {
    inset: 0;
    border-color: rgba(0, 240, 255, 0.4);
    border-top-color: var(--halo);
    animation: ring-rotate-1 12s linear infinite;
  }
  
  .ring-2 {
    inset: 15px;
    border-color: rgba(112, 128, 255, 0.3);
    border-right-color: var(--tether);
    animation: ring-rotate-2 18s linear infinite reverse;
  }
  
  .ring-3 {
    inset: 30px;
    border-color: rgba(255, 77, 109, 0.2);
    border-bottom-color: var(--heartbeat);
    animation: ring-rotate-3 25s linear infinite;
  }
  
  @keyframes ring-rotate-1 {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  
  @keyframes ring-rotate-2 {
    from { transform: rotate(0deg) scale(1); }
    50% { transform: rotate(180deg) scale(1.05); }
    to { transform: rotate(360deg) scale(1); }
  }
  
  @keyframes ring-rotate-3 {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  
  /* The Living Sphere - Core Entity */
  .core-sphere {
    position: relative;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: radial-gradient(
      circle at 30% 30%,
      rgba(0, 240, 255, 0.8) 0%,
      rgba(112, 128, 255, 0.6) 30%,
      rgba(0, 240, 255, 0.4) 60%,
      transparent 100%
    );
    animation: sphere-breathe 4s ease-in-out infinite;
    box-shadow: 
      0 0 30px var(--halo-glow),
      0 0 60px var(--halo-glow),
      inset 0 0 30px rgba(0, 240, 255, 0.3);
  }
  
  .sphere-surface {
    position: absolute;
    inset: 5px;
    border-radius: 50%;
    background: radial-gradient(
      circle at 40% 40%,
      rgba(255, 255, 255, 0.4) 0%,
      transparent 50%
    );
    animation: surface-shimmer 3s ease-in-out infinite;
  }
  
  .sphere-glow {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      var(--halo-glow) 0%,
      transparent 70%
    );
    animation: sphere-glow 4s ease-in-out infinite alternate;
  }
  
  .sphere-shine {
    position: absolute;
    top: 15%;
    left: 20%;
    width: 20px;
    height: 10px;
    background: rgba(255, 255, 255, 0.6);
    border-radius: 50%;
    filter: blur(3px);
    animation: shine-move 6s ease-in-out infinite;
  }
  
  @keyframes sphere-breathe {
    0%, 100% { 
      transform: scale(1); 
      box-shadow: 
        0 0 30px var(--halo-glow),
        0 0 60px var(--halo-glow),
        inset 0 0 30px rgba(0, 240, 255, 0.3);
    }
    50% { 
      transform: scale(1.08); 
      box-shadow: 
        0 0 50px var(--halo-glow),
        0 0 100px var(--halo-glow),
        inset 0 0 40px rgba(0, 240, 255, 0.4);
    }
  }
  
  @keyframes surface-shimmer {
    0%, 100% { opacity: 0.6; transform: rotate(0deg); }
    50% { opacity: 0.9; transform: rotate(10deg); }
  }
  
  @keyframes sphere-glow {
    0% { opacity: 0.5; transform: scale(1); }
    100% { opacity: 0.8; transform: scale(1.15); }
  }
  
  @keyframes shine-move {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(5px, 3px); }
  }
  
  /* Breathing Pulse Waves */
  .core-pulse {
    position: absolute;
    inset: 20px;
    border-radius: 50%;
    border: 2px solid var(--halo);
    opacity: 0;
    animation: pulse-expand 3s ease-out infinite;
  }
  
  .pulse-delayed {
    animation-delay: 1.5s;
  }
  
  @keyframes pulse-expand {
    0% { 
      transform: scale(0.8); 
      opacity: 0.8; 
    }
    100% { 
      transform: scale(2.5); 
      opacity: 0; 
    }
  }
  
  /* Ambient Glow */
  .core-glow {
    position: absolute;
    inset: -50px;
    background: radial-gradient(
      circle,
      var(--halo-glow) 0%,
      transparent 60%
    );
    opacity: 0.4;
    animation: ambient-glow 6s ease-in-out infinite;
    pointer-events: none;
  }
  
  .core-aurora {
    position: absolute;
    inset: -80px;
    background: conic-gradient(
      from 0deg,
      transparent 0deg,
      var(--halo-glow) 60deg,
      transparent 120deg,
      var(--tether-glow) 180deg,
      transparent 240deg,
      var(--heartbeat-glow) 300deg,
      transparent 360deg
    );
    border-radius: 50%;
    opacity: 0.15;
    animation: aurora-spin 30s linear infinite;
    filter: blur(30px);
    pointer-events: none;
  }
  
  @keyframes ambient-glow {
    0%, 100% { opacity: 0.4; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(1.1); }
  }
  
  @keyframes aurora-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  
  @media (max-width: 768px) {
    .aura-core {
      width: 240px;
      height: 240px;
    }
    
    .core-inner {
      width: 150px;
      height: 150px;
    }
    
    .core-sphere {
      width: 60px;
      height: 60px;
    }
  }
</style>
