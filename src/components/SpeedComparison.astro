---
// Speed Comparison Section - Updated to use AURA Router instead of Gemini
---

<section id="features" class="speed-section reveal-section">
  <div class="section-header">
    <span class="section-tag reveal-item" data-delay="0">
      <i data-lucide="zap" class="tag-icon"></i>
      Lightning Fast
    </span>
    <h2 class="section-title reveal-item" data-delay="100">Split-Second Reflexes</h2>
    <p class="section-subtitle reveal-item" data-delay="200">While others are still thinking, AURA has already acted.</p>
  </div>
  
  <div class="speed-comparison">
    <!-- Competitor Side -->
    <div class="terminal-card competitor reveal-item" data-delay="300">
      <div class="terminal-header">
        <div class="terminal-dots">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
        </div>
        <span class="terminal-title">Traditional AI</span>
        <i data-lucide="clock" class="terminal-icon text-muted"></i>
      </div>
      <div class="terminal-body">
        <div class="chat-message user">Schedule a meeting with the design team</div>
        <div class="chat-message ai">
          <span class="typing-indicator">
            <span class="typing-dot"></span>
            <span class="typing-dot"></span>
            <span class="typing-dot"></span>
          </span>
          <span class="typing-text">Thinking...</span>
        </div>
      </div>
      <div class="terminal-footer">
        <span class="processing-time slow">Processing: 2,450ms</span>
      </div>
    </div>
    
    <!-- AURA Side -->
    <div class="terminal-card aura glass reveal-item" data-delay="500">
      <div class="terminal-header">
        <div class="terminal-dots">
          <span class="dot cyan"></span>
          <span class="dot cyan"></span>
          <span class="dot cyan"></span>
        </div>
        <span class="terminal-title">AURA</span>
        <i data-lucide="zap" class="terminal-icon text-halo"></i>
      </div>
      <div class="terminal-body">
        <div class="chat-message user">Schedule a meeting with the design team</div>
        <div class="chat-message ai aura-response">
          <i data-lucide="check-circle" class="response-icon"></i>
          Done! Meeting scheduled for tomorrow at 2 PM. I've notified the team.
        </div>
      </div>
      <div class="terminal-footer">
        <span class="processing-time fast">Processing: 12ms</span>
        <span class="model-tag glass">AURA Router</span>
      </div>
    </div>
  </div>
</section>
